{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-hackaton.github.io/contracts/ai-analysis.schema.json",
  "title": "AIAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_id",
    "detected_activities",
    "decision",
    "decision_confidence",
    "matched_policy_ids",
    "reason",
    "requires_human_review"
  ],
  "properties": {
    "analysis_id": {
      "type": "string",
      "pattern": "^analysis_[A-Za-z0-9_-]+$"
    },
    "detected_activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["activity_id", "confidence", "visual_evidence"],
        "properties": {
          "activity_id": {
            "type": "string",
            "enum": [
              "reading_book",
              "studying",
              "playing_video_game",
              "watching_short_form",
              "unknown"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "visual_evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": ["PASS", "FAIL", "HUMAN_REVIEW"]
    },
    "decision_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "matched_policy_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^policy_[a-z0-9_]+$"
      },
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "requires_human_review": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"decision": {"const": "HUMAN_REVIEW"}},
        "required": ["decision"]
      },
      "then": {
        "properties": {"requires_human_review": {"const": true}}
      },
      "else": {
        "properties": {"requires_human_review": {"const": false}}
      }
    }
  ]
}
